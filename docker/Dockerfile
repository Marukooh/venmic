FROM nixos/nix:latest

# +--------------------------------------------------------------------------------------------------------+
# | Setup Nix                                                                                              |
# +--------------------------------------------------------------------------------------------------------+

RUN echo "filter-syscalls = false" >> /etc/nix/nix.conf # See https://github.com/NixOS/nix/issues/5258 
RUN echo "experimental-features = nix-command flakes" >> /etc/nix/nix.conf

# +--------------------------------------------------------------------------------------------------------+
# | Pre-Fetch Flake content and setup git                                                                  |
# +--------------------------------------------------------------------------------------------------------+

WORKDIR /work

COPY flake.nix .
RUN nix develop --command git config --global --add safe.directory '/work'

# +--------------------------------------------------------------------------------------------------------+
# | Setup entrypoint                                                                                       |
# +--------------------------------------------------------------------------------------------------------+

ENTRYPOINT ["nix", "develop", "--command", "sh", "-c"]
